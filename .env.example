NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_NAME=test_project_1
DEPLOYMENT_ENVIRONMENT=mac_mini

DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=test_project_1

DB_SYNCHRONIZE=true
DB_LOGGING=true

QUEUE_REDIS_HOST=redis
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_DB=0

# S3-compatible storage (MinIO when running compose).
AWS_S3_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
FILE_MANAGEMENT_BUCKET_NAME=vyapti-be
FILE_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:${PORT_minio_9000:-9000}/vyapti-be

# Auth. The HTTP app boots only when both JWT PEMs are set.
# Generate writes real keys into gitignored `.env` (never commit private keys).
# Use \n for PEM newlines when the value is a single quoted line.
#
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
# openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
APP_JWT_PRIVATE_KEY=
APP_JWT_PUBLIC_KEY=

# First admin is seeded on boot when both values are set and no user exists.
# Change the password after first login. Signup is admin-creates (no public register).
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Issue an API key after login:
#   curl -X POST "$API/auth/api-keys" \
#     -H "Authorization: Bearer $ACCESS_TOKEN" \
#     -H "Content-Type: application/json" \
#     -d '{"name":"local"}'
# List returns prefix + metadata only (never the secret). Rotate by issuing a
# new key and DELETE /auth/api-keys/:id. Target: under two minutes.
#
# Unauthenticated GET /auth/me → 401. Health-check stays public.

# Browser clients that send the refresh cookie. Unset reflects the request origin.
# Cookies are host-only (no Domain) so this app does not share identity with the
# control plane even on a sibling subdomain.
# CORS_ORIGIN=http://localhost:3000
# CORS_CREDENTIALS=true
