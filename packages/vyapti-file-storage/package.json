{
    "name": "@vyapti/file-storage",
    "version": "1.0.0",
    "description": "S3-compatible object storage helpers for Vyapti file operations",
    "private": true,
    "license": "UNLICENSED",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1031.0",
        "@aws-sdk/s3-request-presigner": "^3.1031.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.7",
        "typescript": "^5.7.3"
    }
}
