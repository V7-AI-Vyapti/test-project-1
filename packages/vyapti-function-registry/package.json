{
    "name": "@vyapti/function-registry",
    "version": "1.0.0",
    "description": "Atomic runtime functions and metadata for Vyapti configure-tools",
    "private": true,
    "license": "UNLICENSED",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "rm -rf dist"
    },
    "devDependencies": {
        "@types/node": "^22.10.7",
        "typescript": "^5.7.3"
    },
    "dependencies": {
        "@vyapti/core": "workspace:*",
        "typeorm": "^0.3.28"
    }
}
