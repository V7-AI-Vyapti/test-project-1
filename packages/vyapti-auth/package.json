{
    "name": "@vyapti/auth",
    "version": "1.0.0",
    "description": "Shared NestJS auth module for the Vyapti control plane and generated projects",
    "private": true,
    "license": "UNLICENSED",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
