    },
    "devDependencies": {
        "@nestjs/common": "^11.0.1",
        "@nestjs/core": "^11.0.1",
        "@nestjs/swagger": "^11.2.6",
        "@types/node": "^22.10.7",
        "nestjs-zod": "^5.3.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "typescript": "^5.7.3",
        "zod": "^4.4.3"
